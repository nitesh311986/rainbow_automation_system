// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model ItemMaster {
  id         String   @id @default(uuid())
  item_name  String
  size       String?
  weight     Float?
  length     Float?
  image_url  String?
  created_at DateTime @default(now())

  orderItems OrderItem[]

  @@map("item_master")
}

model Order {
  id             String    @id @default(uuid())
  order_no       String    @unique
  order_date     DateTime
  po_number      String?
  po_date        DateTime?
  due_date       DateTime?
  customer_name  String
  project_number String?
  status         String    @default("Pending")

  orderItems OrderItem[]

  @@map("orders")
}

model OrderItem {
  id       String @id @default(uuid())
  order_id String
  item_id  String
  quantity Int
  unit     String
  price    Float

  order Order      @relation(fields: [order_id], references: [id], onDelete: Cascade)
  item  ItemMaster @relation(fields: [item_id], references: [id], onDelete: Cascade)

  @@map("order_items")
}
